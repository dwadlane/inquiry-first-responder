# Port this service listens on
PORT=3100

# Your Chatwoot install, no trailing slash
CHATWOOT_BASE_URL=http://localhost:3000

# The Agent Bot access token and webhook signing value, both shown by Chatwoot
# when you create the bot. Fill these in your own .env, never commit them.
CHATWOOT_BOT_TOKEN=
CHATWOOT_WEBHOOK_SECRET=

# Only for local experiments. Lets unsigned requests through. Leave off in real use.
ALLOW_UNSIGNED=false

# Optional: let Claude reword the planned replies. The rule engine still decides everything.
# Set FIRST_RESPONDER_DRAFTER=claude and add an Anthropic key to turn it on.
FIRST_RESPONDER_DRAFTER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
