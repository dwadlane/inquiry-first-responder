{
  "name": "g2-demo-first-responder",
  "version": "0.1.0",
  "description": "Inquiry First Responder: a small Agent Bot service for Chatwoot that qualifies inquiries and hands off to a person. Demo with sample data.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:demo",
    "build:demo": "node scripts/build-demo.mjs",
    "start": "node dist/server/main.js",
    "dev": "tsx src/server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "node scripts/serve-demo.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.50.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
